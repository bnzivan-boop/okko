# Copy to backend/.env.local and fill in. NEVER commit the real file.
# .gitignore already excludes .env*.local

# ---- Supabase (Project settings → API) -------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...                 # public, goes into the frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # SECRET, edge functions only

# ---- Site ------------------------------------------------------------------
SITE_ORIGIN=https://okkocap.com          # used for CORS and links in emails

# ---- Stripe (Developers → API keys) ----------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...          # from the webhook endpoint you create
STRIPE_PRICE_M1=price_...                # AED 499 / month
STRIPE_PRICE_M3=price_...                # AED 999 / 3 months

# ---- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=re_...
MAIL_FROM=OKKO CAP <deals@okkocap.com>

# ---- WhatsApp (optional, Twilio) -------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
